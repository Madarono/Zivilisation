  m_Script: {fileID: 11500000, guid: e1fb3e7da7791bf42972e8814c221ec0, type: 3}
  m_Name: BuildRoad
  m_EditorClassIdentifier: Assembly-CSharp::TutorialSO
  type: 4
  startingPopup: Tap on the Build Options
  showSelection: 1
  position: {x: -765, y: 475}
  size: {x: 100, y: 100}
  steps:
  - scriptName: BuildSystem
    functionName: StartBuilding
    popupTextVisual: Open Roads
    showSelection: 1
    position: {x: -765, y: 375}
    size: {x: 80, y: 80}
  - scriptName: BuildSystem
    functionName: StartRoad
    popupTextVisual: Place a road anywhere on the grid
    showSelection: 0
    position: {x: -765, y: 375}
    size: {x: 80, y: 80}
  - scriptName: RoadSystem
    functionName: PutRoad
    popupTextVisual: Use multibrush to place more at once!
    showSelection: 1
    position: {x: 894.9401, y: -15.00018}
    size: {x: 100, y: 100}
  - scriptName: RoadSystem
    functionName: Multi
    popupTextVisual: Place multiple roads by dragging existing roads
    showSelection: 0
    position: {x: 894.9401, y: -15.00018}
    size: {x: 100, y: 100}
  - scriptName: RoadSystem
    functionName: PutMultiRoad
    popupTextVisual: Use shovel to delete roads!
    showSelection: 1
    position: {x: 894.9401, y: -130.0001}
    size: {x: 100, y: 100}
  - scriptName: RoadSystem
    functionName: DeleteRoad
    popupTextVisual: Select on any existing road to delete, multibrush helps delete
      many at once!
    showSelection: 0
    position: {x: 894.9401, y: -130.0001}
    size: {x: 100, y: 100}
  congratsStep:
    scriptName: RoadSystem
    functionName: DeleteRoad
    popupTextVisual: Congrats!
    showSelection: 0
    position: {x: -765, y: 475}
    size: {x: 100, y: 100}
  failTutorial:
