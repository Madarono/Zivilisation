  m_EditorClassIdentifier: Assembly-CSharp::DevSidePage
  leftPageInfo: "<align=center><size=140%>- Market -</size></align>\nMarket is a
    player building, you can only have one at a time.\n\n<align=center><size=120%>-
    Usage -</size></align>\nSell resources, each have their own <color=#305D42><size=110%><i>base
    worth</i></size></color> that changes every day based on <color=#305D42><size=110%><i>demand.</i></size></color>.
    \n\n<align=center><size=120%>- Daily Demand -</size></align>\r\nDemands shift
    daily (<color=#305D42><size=110%><i>50</i></color>-<color=#305D42><size=110%><i>200%</i></size></color>
    of <color=#305D42><size=110%><i>base worth</i></size></color>):"
